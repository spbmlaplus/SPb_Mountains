{
  "_comment": "Base composition generated by scripts/gen-base-map.py from new_legend/BASE_MAP.csv (id_map=1). Single global basemap stack: Positron+labels, relief_water1@55%, then calibrated geojson vectors. Non-clickable, no legend.",
  "id_layer_base": 1,
  "render_order": [
    {
      "kind": "raster",
      "name": "positron_labels",
      "source": "https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}@2x.png",
      "absolute_url": true,
      "minzoom": 0,
      "maxzoom": 19,
      "attribution": "© OpenStreetMap contributors © CARTO"
    },
    {
      "kind": "raster",
      "name": "relief_water1",
      "source": "relief_water1/{z}/{x}/{y}.png",
      "scheme": "tms",
      "minzoom": 10,
      "maxzoom": 14,
      "opacity": 0.55
    },
    {
      "kind": "vector",
      "name": "isoline_5m",
      "geojson": "isoline_5m.geojson",
      "style": {
        "line": {
          "color": "#b99a87",
          "width_px": 0.11
        }
      }
    },
    {
      "kind": "vector",
      "name": "sectors_level",
      "geojson": "sectors_level.geojson",
      "style": {
        "outline": {
          "color": "rgb(0,0,0)",
          "width_px": 1.0,
          "opacity": 1.0,
          "dasharray": [
            4,
            2
          ]
        }
      }
    },
    {
      "kind": "vector",
      "name": "amphitheater_bound",
      "geojson": "amphitheater_bound.geojson",
      "style": {
        "line": {
          "color": "rgb(67,69,69)",
          "width_px": 1.4
        }
      }
    }
  ],
  "px_per_mm_assumption": 2.83
}
