{
  "_comment": "Base composition #1 — ported 2026-06-18 from new_legend/Базовые_слои.csv. Runtime source of truth for the single global basemap stack.",
  "id_layer_base": 1,
  "render_order": [
    {
      "kind": "raster",
      "name": "positron_nolabels",
      "source": "https://a.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}@2x.png",
      "absolute_url": true,
      "minzoom": 0,
      "maxzoom": 19,
      "opacity": 0.4,
      "attribution": "© OpenStreetMap contributors © CARTO",
      "note": "CSV row `positron без подписей`, opacity 40%."
    },
    {
      "kind": "raster",
      "name": "relief_water1",
      "source": "relief_water1/{z}/{x}/{y}.png",
      "scheme": "tms",
      "minzoom": 10,
      "maxzoom": 14,
      "note": "Pre-baked relief+water raster. Tile files on disk use TMS row indices (build script flips morecantile rows). MapLibre must use scheme=tms. Deployed at https://spbmlaplus.github.io/spb_mountains_tiles/relief_water1/{z}/{x}/{y}.png"
    },
    {
      "kind": "vector",
      "name": "isoline_5m",
      "geojson": "isoline_5m.geojson",
      "qml": "src/assets/styles/isoline_5m.qml",
      "style": {
        "line": { "color": "rgb(225,89,137)", "width_px": 1.0 }
      }
    },
    {
      "kind": "vector",
      "name": "amphitheater_bound",
      "geojson": "amphitheater_bound.geojson",
      "qml": "src/assets/styles/amphitheater_bound.qml",
      "style": {
        "line": { "color": "rgb(67,69,69)", "width_px": 1.4 }
      }
    },
    {
      "kind": "vector",
      "name": "sectors_level",
      "geojson": "sectors_level.geojson",
      "qml": "src/assets/styles/sectors_level.qml",
      "style": {
        "outline": { "color": "rgb(0,0,0)", "width_px": 1.0, "opacity": 1.0, "dasharray": [4, 2] }
      }
    }
  ],
  "px_per_mm_assumption": 2.83,
  "calibration_note": "QML widths in mm; outline widths bumped to ≥1 px for legibility at typical zoom."
}
