{
  "name": "map-view-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python scripts/copy-new-assets.py && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "visual:build": "cross-env VITE_BASE_PATH=/ tsc -b && cross-env VITE_BASE_PATH=/ vite build",
    "visual:capture": "playwright test --config=visual-tests/playwright.config.ts",
    "visual:diff": "tsx visual-tests/diff.ts",
    "visual:report": "tsx visual-tests/report.ts",
    "visual": "npm run visual:build && start-server-and-test 'cross-env VITE_BASE_PATH=/ vite preview --port 4173' http://localhost:4173 'npm run visual:capture && npm run visual:diff && npm run visual:report'",
    "visual:task": "npm run visual --"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
